# ---- Required in production ----
NEXT_PUBLIC_SITE_URL=https://www.juliawarter.com

# ---- Native store (Stripe). Leave blank and every Buy button falls back to the Stan listing. ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` or the Dashboard webhook for /api/webhooks/stripe
STRIPE_PRICE_LRM_DIET=price_...          # The Lymphatic Reset Diet™ ($97 placeholder — confirm)
STRIPE_PRICE_LRM_METHOD=price_...        # The Lymphatic Reset Method™ ($297)
STRIPE_PRICE_LRM_ULTIMATE=price_...      # The Ultimate Lymphatic Reset™ ($397 placeholder — confirm)
STRIPE_PRICE_COACHING=price_...          # 1:1 Gut & Lymphatic Reset Coaching ($249)
STRIPE_AUTOMATIC_TAX=false

# ---- Email list (pick ONE; the newsletter API uses whichever is set, in this order) ----
KIT_API_KEY=                             # Kit / ConvertKit v3 API key
KIT_FORM_ID=                             # the form new subscribers join
KIT_PURCHASE_TAG_ID=                     # tag applied by the Stripe webhook after a purchase (triggers access email)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
NEWSLETTER_WEBHOOK_URL=                  # generic fallback (Zapier/Make) — receives {email, firstName, source, tags}

# ---- Contact form (pick one) ----
RESEND_API_KEY=
CONTACT_FROM="Website <hello@juliawarter.com>"
CONTACT_TO=contactjuliawarter@gmail.com
CONTACT_WEBHOOK_URL=

# ---- First-party click tracking: every /go/<slug> redirect + site events POST here (Zapier → Google Sheet works great) ----
CLICK_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_URL=                 # purchase events from the Stripe webhook

# ---- Optional pixels ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---- Donate button (Stripe Payment Link or PayPal.me) ----
NEXT_PUBLIC_DONATE_LINK=
